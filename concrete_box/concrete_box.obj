# Concrete Box Room - Interior faces visible (10x10x10 units, centered at origin)
# Usage: load in any OBJ viewer; camera should be placed inside the box
mtllib concrete_box.mtl

# Vertices (8 corners of the box, from -5 to +5 on each axis)
v -5.0 -5.0 -5.0
v  5.0 -5.0 -5.0
v  5.0 -5.0  5.0
v -5.0 -5.0  5.0
v -5.0  5.0 -5.0
v  5.0  5.0 -5.0
v  5.0  5.0  5.0
v -5.0  5.0  5.0

# UV coordinates (shared across all faces)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals pointing INWARD (so faces are visible from inside the room)
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0

o ConcreteRoom
usemtl concrete

# Floor (y = -5, normal pointing up = inward)
f 1/1/1 2/2/1 3/3/1 4/4/1

# Ceiling (y = +5, normal pointing down = inward)
f 5/1/2 8/2/2 7/3/2 6/4/2

# Back wall (z = -5, normal pointing +z = inward)
f 1/1/4 5/2/4 6/3/4 2/4/4

# Front wall (z = +5, normal pointing -z = inward)
f 3/1/3 7/2/3 8/3/3 4/4/3

# Left wall (x = -5, normal pointing +x = inward)
f 4/1/5 8/2/5 5/3/5 1/4/5

# Right wall (x = +5, normal pointing -x = inward)
f 2/1/6 6/2/6 7/3/6 3/4/6
